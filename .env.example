# Google Gemini API Key
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model Name
# Options: gemini-3.1-flash-lite (fastest/highest availability), gemini-3.5-flash-lite, gemini-3.5-flash, gemini-3.8-flash
GEMINI_MODEL=gemini-3.1-flash-lite
